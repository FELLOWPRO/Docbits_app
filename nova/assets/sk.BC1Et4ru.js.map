  "biz_preset_lax": "Laxný",
  "biz_preset_standard": "Štandard",
  "biz_preset_strict": "Prísne",
  "biz_profile_b2b_domestic_desc": "KoSIT je vo všetkých prípadoch neplatný. Spoločná platba cez IBAN. Bezpečný základ pre väčšinu nemeckej B2B prevádzky.",
  "biz_profile_b2b_domestic_label": "B2B Domestic – štandardné nemecké B2B",
  "biz_profile_b2b_eu_desc": "Dodávky v rámci Spoločenstva. Povolená je možnosť prenesenia daňovej povinnosti. Akceptujú sa aj iné IBAN ako nemecké. Vyhľadávanie IČ DPH v reálnom čase cez VIES je štandardne zapnuté.",
  "biz_profile_b2b_eu_label": "B2B cezhraničné obchodovanie v EÚ",
  "biz_profile_b2g_desc": "Prijímajte XRechnung od nemeckých odosielateľov z verejného sektora. Prísne dodržiavanie normy EN 16931 + DE CIUS; vyžaduje sa Leitweg-ID. Neplatné faktúry sú zamietnuté a dodávatelia sú informovaní.",
  "biz_profile_b2g_label": "B2G – Verejný správca",
  "biz_profile_custom_desc": "Prejdite si podrobné otázky a vytvorte si politiku prispôsobenú vašim špecifickým scenárom. Použite to, keď vám nevyhovuje žiadny z rýchlych profilov.",
  "biz_profile_custom_label": "Vlastné – odpovedzte na podrobné otázky",
  "biz_profile_migration_desc": "Režim iba s protokolovaním pre nové zavádzania elektronických faktúr. Každé porušenie sa degraduje na varovanie, aby dodávatelia mohli vykonať úpravy bez blokovania svojich faktúr.",
  "biz_profile_migration_label": "Migrácia / Testovanie",
  "biz_q_a1_help": "Verzie, ktoré nie sú v tomto zozname, sú zamietnuté s parametrom VAL-VERSION-NOT-ALLOWED pred spustením akejkoľvek inej kontroly. Prázdny zoznam = akceptovať všetko.",
  "biz_q_a1_label": "Ktoré verzie XRechnung akceptujete?",
  "biz_q_a1_opt_1": {
    "2": "1.2"
  },
  "biz_q_a1_opt_2": {
    "0": "2.0",
    "1": "2.1",
    "2": "2.2",
    "3": "2.3"
  },
  "biz_q_a1_opt_3": {
    "0": "3.0"
  },
  "biz_q_a2_help": "Profily, ktoré nie sú v tomto zozname, sú zamietnuté s chybou VAL-PROFILE-NOT-ALLOWED. MINIMUM a BASIC WL nie sú v súlade s normou EN 16931 – povoľte ich iba v prípade, že ich konkrétne potrebujete.",
  "biz_q_a2_label": "Ktoré profily ZUGFeRD / Factur-X akceptujete?",
  "biz_q_a2_opt_basic": "ZÁKLADNÉ",
  "biz_q_a2_opt_basic_wl": "ZÁKLADNÉ WL",
  "biz_q_a2_opt_en16931": "EN 16931",
  "biz_q_a2_opt_extended": "ROZŠÍRENÉ",
  "biz_q_a2_opt_minimum": "MINIMÁLNE",
  "biz_q_a2_opt_xrechnung": "XRECHNUNG",
  "biz_q_a3_help": "Hybridné elektronické faktúry technicky vyžadujú PDF/A-3. Povolenie A-1 / A-2 znižuje úroveň zistenia PDFA-NOT-A3 z fatálneho na varovanie.",
  "biz_q_a3_label": "Povoliť PDF/A-1 alebo PDF/A-2 namiesto PDF/A-3?",
  "biz_q_a3_opt_no": "Nie – iba PDF/A-3",
  "biz_q_a3_opt_yes": "Áno – povoľujú sa aj A-1 / A-2",
  "biz_q_b1_help": "Ak áno, všetky kontroly súvisiace s IBAN (BR-DE-19/20, VAL-IBAN-*) sa prehodnotia na varovanie.",
  "biz_q_b1_label": "Prijímate faktúry bez IBAN vôbec?",
  "biz_q_b1_opt_no": "Nie – vyžaduje sa IBAN",
  "biz_q_b1_opt_yes": "Áno – IBAN voliteľný",
  "biz_q_b2_help": "Iba pre Nemecko je určené čisto pre domácich nemeckých dodávateľov. EÚ povoľuje akúkoľvek krajinu s normou ISO 3166 (odporúča sa pre cezhraničný AP).",
  "biz_q_b2_label": "Ktoré krajiny by mali mať povolený IBAN?",
  "biz_q_b2_opt_de_only": "Iba pre DE",
  "biz_q_b2_opt_eu": "Ktorákoľvek krajina EÚ",
  "biz_q_b3_help": "Ak áno, kódy BR-50 / BR-51 a overovacie kódy BIC sa povýšia na chybu.",
  "biz_q_b3_label": "Je BIC povinný?",
  "biz_q_b3_opt_no": "Nie – BIC voliteľný",
  "biz_q_b3_opt_yes": "Áno – vyžaduje sa BIC",
  "biz_q_c1_help": "Nie → Pravidlá BR-AE-* sa stávajú chybami a faktúry s prenesením daňovej povinnosti sú zamietnuté predtým, ako vstúpia do AP.",
  "biz_q_c1_label": "Akceptujete faktúry s prenesením daňovej povinnosti (§13b UStG)?",
  "biz_q_c1_opt_no": "Nie – zamietnuť prenesenie daňovej povinnosti",
  "biz_q_c1_opt_yes": "Áno",
  "biz_q_c2_help": "Nie → Pravidlá BR-IC-* sa stávajú chybami. Áno je správna odpoveď pre takmer všetky reálne nastavenia prístupových bodov.",
  "biz_q_c2_label": "Akceptujete faktúry v rámci EÚ?",
  "biz_q_c2_opt_no": "Nie – zamietnuť v rámci komunity",
  "biz_q_c2_opt_yes": "Áno",
  "biz_q_c3_help": "0 € odmieta každý cent odchýlky. 0,01 € zodpovedá predvolenej hodnote KoSIT a absorbuje prirodzené zaokrúhľovanie. 0,05 € je tolerantné nastavenie pre tradičných dodávateľov.",
  "biz_q_c3_label": "Tolerancia zaokrúhľovania pre daňovú sumu (EUR)",
  "biz_q_c3_opt_0": "0 € (prísne)",
  "biz_q_c3_opt_0.01": "0,01 € (predvolené)",
  "biz_q_c3_opt_0.05": "0,05 € (zmierlivý)",
  "biz_q_d1_help": "Dodávatelia B2G musia vždy uvádzať Leitweg-ID. Ak dostanete mix, vyberte možnosť „B2G-required“ (Povinné pre B2G), alebo „Always required“ (Vždy povinné), ak to chcete vynútiť vo všetkých oblastiach.",
  "biz_q_d1_label": "Je potrebné referenčné číslo kupujúceho (Leitweg-ID)?",
  "biz_q_d1_opt_always_required": "Vždy povinné",
  "biz_q_d1_opt_b2g_required": "Dodávatelia B2G to musia citovať",
  "biz_q_d1_opt_optional": "Voliteľné",
  "biz_q_d2_help": "VIES je adresár IČ DPH v EÚ. Funkcia Live-lookup zachytáva neplatné zahraničné IČ DPH pri príjme, ale pridáva sieťové volanie ku každej faktúre – pri veľkých domácich nastaveniach túto funkciu vynechajte.",
  "biz_q_d2_label": "Vyhľadávanie IČ DPH v reálnom čase cez VIES?",
  "biz_q_d2_opt_no": "Nie – preskočiť vyhľadávanie",
  "biz_q_d2_opt_yes": "Áno – overiť online",
  "biz_q_e1_help": "Zamietnuť = faktúra prejde do stavu CHYBA; tím AP musí zasiahnuť. Prijať s upozornením = faktúra pokračuje s bannerom. Iba protokolovať = každé zistenie je znížené na upozornenie (testovací režim).",
  "biz_q_e1_label": "Čo sa stane v prípade zlyhania overenia?",
  "biz_q_e1_opt_accept_with_warning": "Prijať s varovaním",
  "biz_q_e1_opt_log_only": "Iba protokol (testovací režim)",
  "biz_q_e1_opt_reject": "Zamietnuť faktúru",
  "biz_q_e2_help": "Ak áno, v prípade zamietnutia sa dodávateľovi odošle e-mail so zoznamom zistení z validácie, aby mohol vydať opravu.",
  "biz_q_e2_label": "Informovať dodávateľa o odmietnutí?",
  "biz_q_e2_opt_no": "Nie – tiché odmietnutie",
  "biz_q_e2_opt_yes": "Áno – e-mail dodávateľa",
