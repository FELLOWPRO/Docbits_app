{
  "schema_version": 1,
  "locales": [
    "en",
    "de",
    "it",
    "fr",
    "es",
    "nl",
    "zh",
    "bg",
    "cs",
    "hu",
    "ja",
    "ko",
    "pl",
    "pt",
    "pt-br",
    "ro",
    "sk",
    "sl",
    "sv",
    "th",
    "tr",
    "vi"
  ],
  "english_audio_locales": [
    "hu",
    "sl",
    "th",
    "vi"
  ],
  "routes": [
    {
      "video_key": "layouts",
      "pattern": "^/settings/doc-type-settings/[A-Za-z0-9_-]{1,128}/layouts$"
    },
    {
      "video_key": "layouts",
      "pattern": "^/settings/doc-type-settings/[A-Za-z0-9_-]{1,128}/layouts/selection-rules/[A-Za-z0-9_-]{1,128}$"
    },
    {
      "video_key": "transformation-rules",
      "pattern": "^/settings/transformation-rules/[A-Za-z0-9_-]{1,128}$"
    },
    {
      "video_key": "transformation-rules",
      "pattern": "^/settings/transformation-rules/[A-Za-z0-9_-]{1,128}/[A-Za-z0-9_-]{1,128}$"
    },
    {
      "video_key": "custom-validation-rules",
      "pattern": "^/settings/custom-validation-rules/[A-Za-z0-9_-]{1,128}$"
    },
    {
      "video_key": "custom-validation-rules",
      "pattern": "^/settings/custom-validation-rules/[A-Za-z0-9_-]{1,128}/[A-Za-z0-9_-]{1,128}$"
    },
    {
      "video_key": "field_settings",
      "pattern": "^/settings/fields/[A-Za-z0-9_-]{1,128}$"
    },
    {
      "video_key": "field_settings",
      "pattern": "^/settings/fields/[A-Za-z0-9_-]{1,128}/(?!master-data$|master_data$)[A-Za-z0-9_-]{1,128}$"
    },
    {
      "video_key": "lookup_configuration",
      "pattern": "^/settings/fields/[A-Za-z0-9_-]{1,128}(?:/[A-Za-z0-9_-]{1,128})?/master-data$"
    },
    {
      "video_key": "lookup_configuration",
      "pattern": "^/settings/data-validation$"
    },
    {
      "video_key": "master_data_mappings",
      "pattern": "^/settings/master-data$"
    },
    {
      "video_key": "master_data_mappings",
      "pattern": "^/settings/invoice-calculation$"
    },
    {
      "video_key": "users",
      "pattern": "^/settings/users$"
    },
    {
      "video_key": "sub_organizations",
      "pattern": "^/settings/sub-organizations$"
    },
    {
      "video_key": "einvoice-validation",
      "pattern": "^/settings/einvoice-validation$"
    }
  ],
  "max_raw_length": 200,
  "object_key_pattern": "^settings-assistant/(layouts|transformation-rules|custom-validation-rules|field_settings|lookup_configuration|master_data_mappings|sub_organizations|users|einvoice-validation)/v[1-9][0-9]*/(en|de|it|fr|es|nl|zh|bg|cs|hu|ja|ko|pl|pt|pt-br|ro|sk|sl|sv|th|tr|vi)\\.(mp4|vtt|png)$"
}
