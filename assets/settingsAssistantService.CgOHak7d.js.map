{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocBits page video SSE frame v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "video",
    "trace_id",
    "docbits_trace_id"
  ],
  "properties": {
    "type": {
      "const": "page_video"
    },
    "video": {
      "$ref": "#/$defs/video"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u0020\\u007f]+$"
    },
    "docbits_trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u0020\\u007f]+$"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locale": {
      "enum": [
        "en",
        "de",
        "it",
        "fr",
        "es",
        "nl",
        "zh",
        "bg",
        "cs",
        "hu",
        "ja",
        "ko",
        "pl",
        "pt",
        "pt-br",
        "ro",
        "sk",
        "sl",
        "sv",
        "th",
        "tr",
        "vi"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "bytes",
        "mime"
      ],
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https://docbits-videos\\.fra1\\.cdn\\.digitaloceanspaces\\.com/settings-assistant/(layouts|transformation-rules|custom-validation-rules|field_settings|lookup_configuration|master_data_mappings|sub_organizations|users|einvoice-validation)/v[1-9][0-9]*/(en|de|it|fr|es|nl|zh|bg|cs|hu|ja|ko|pl|pt|pt-br|ro|sk|sl|sv|th|tr|vi)\\.(mp4|vtt|png)$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "mime": {
          "enum": [
            "video/mp4",
            "text/vtt; charset=utf-8",
            "image/png"
          ]
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "cue_id",
        "start_ms",
        "end_ms",
        "text"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "cue_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}_[0-9]{2}$"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 129999
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 130000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "video_key",
        "content_revision",
        "locale",
        "title",
        "visual_locale",
        "audio_locale",
        "caption_locale",
        "audio_mode",
        "duration_ms",
        "width",
        "height",
        "fps",
        "assets",
        "captions",
        "transcript"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "video_key": {
          "enum": [
            "layouts",
            "transformation-rules",
            "custom-validation-rules",
            "field_settings",
            "lookup_configuration",
            "master_data_mappings",
            "users",
            "sub_organizations",
            "einvoice-validation"
          ]
        },
        "content_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "locale": {
          "$ref": "#/$defs/locale"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "visual_locale": {
          "$ref": "#/$defs/locale"
        },
        "audio_locale": {
          "$ref": "#/$defs/locale"
        },
        "caption_locale": {
          "$ref": "#/$defs/locale"
        },
        "audio_mode": {
          "enum": [
            "localized",
            "english_fallback"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 130000
        },
        "width": {
          "const": 1280
        },
        "height": {
          "const": 720
        },
        "fps": {
          "const": 30
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mp4",
            "vtt",
            "poster"
          ],
          "properties": {
            "mp4": {
              "$ref": "#/$defs/asset"
            },
            "vtt": {
              "$ref": "#/$defs/asset"
            },
            "poster": {
              "$ref": "#/$defs/asset"
            }
          }
        },
        "captions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 120,
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "transcript": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      }
    }
  }
}
