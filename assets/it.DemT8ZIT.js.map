  "guide_po_match_video": "<iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/MjkuVa3IFEw?si=o6nji8eetEcIcCxT\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometro; autoplay; clipboard-write; encrypted-media; giroscopio; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>.",
  "guide_po_search_bar": "Qui è possibile cercare numeri d'ordine d'acquisto specifici.",
