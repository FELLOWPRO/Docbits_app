    "3": "2.3"
  },
  "biz_q_a1_opt_3": {
    "0": "3.0"
  },
  "biz_q_a2_help": "Profily, které nejsou na tomto seznamu, jsou odmítnuty s chybou VAL-PROFILE-NOT-ALLOWED. Profily MINIMUM a BASIC WL neodpovídají normě EN 16931 – povolte je pouze v případě, že je konkrétně potřebujete.",
  "biz_q_a2_label": "Které profily ZUGFeRD / Factur-X akceptujete?",
  "biz_q_a2_opt_basic": "ZÁKLADNÍ",
  "biz_q_a2_opt_basic_wl": "ZÁKLADNÍ WL",
  "biz_q_a2_opt_en16931": "EN 16931",
  "biz_q_a2_opt_extended": "ROZŠÍŘENO",
  "biz_q_a2_opt_minimum": "MINIMÁLNÍ",
  "biz_q_a2_opt_xrechnung": "XRECHNUNG",
  "biz_q_a3_help": "Hybridní elektronické faktury technicky vyžadují PDF/A-3. Povolení A-1 / A-2 snižuje úroveň zjištění PDFA-NOT-A3 z fatální na varování.",
  "biz_q_a3_label": "Povolit PDF/A-1 nebo PDF/A-2 místo PDF/A-3?",
  "biz_q_a3_opt_no": "Ne – pouze PDF/A-3",
  "biz_q_a3_opt_yes": "Ano – povolují se i A-1 / A-2",
  "biz_q_b1_help": "Pokud ano, všechny kontroly související s IBAN (BR-DE-19/20, VAL-IBAN-*) jsou degradovány na varování.",
  "biz_q_b1_label": "Přijímáte faktury bez IBAN vůbec?",
  "biz_q_b1_opt_no": "Ne – IBAN je vyžadován",
  "biz_q_b1_opt_yes": "Ano – IBAN volitelný",
  "biz_q_b2_help": "Pouze DE je určeno pro čistě domácí německé dodavatele. EU povoluje jakoukoli zemi s certifikací ISO 3166 (doporučeno pro přeshraniční AP).",
  "biz_q_b2_label": "Které země by měly mít povolený IBAN?",
  "biz_q_b2_opt_de_only": "Pouze DE",
  "biz_q_b2_opt_eu": "Kterákoli země EU",
  "biz_q_b3_help": "Pokud ano, kódy BR-50 / BR-51 a ověřovací kódy BIC se povýší na chybu.",
