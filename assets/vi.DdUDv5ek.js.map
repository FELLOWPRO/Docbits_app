  "biz_q_a2_opt_minimum": "TỐI THIỂU",
  "biz_q_a2_opt_xrechnung": "XRECHNUNG",
  "biz_q_a3_help": "Về mặt kỹ thuật, hóa đơn điện tử lai yêu cầu định dạng PDF/A-3. Việc cho phép định dạng A-1/A-2 sẽ hạ cấp lỗi PDFA-NOT-A3 từ mức nghiêm trọng xuống mức cảnh báo.",
  "biz_q_a3_label": "Cho phép sử dụng định dạng PDF/A-1 hoặc PDF/A-2 thay vì PDF/A-3?",
  "biz_q_a3_opt_no": "Không — Chỉ có định dạng PDF/A3",
  "biz_q_a3_opt_yes": "Vâng — cũng cho phép A-1 / A-2",
  "biz_q_b1_help": "Nếu có, tất cả các kiểm tra liên quan đến IBAN (BR-DE-19/20, VAL-IBAN-*) sẽ được hạ cấp xuống mức cảnh báo.",
  "biz_q_b1_label": "Chấp nhận hóa đơn mà không cần số IBAN?",
  "biz_q_b1_opt_no": "Không — Cần có IBAN",
  "biz_q_b1_opt_yes": "Có — IBAN tùy chọn",
  "biz_q_b2_help": "DE-only chỉ dành cho các nhà cung cấp nội địa Đức. EU cho phép bất kỳ quốc gia nào đạt chứng nhận ISO 3166 (khuyến nghị cho AP xuyên biên giới).",
  "biz_q_b2_label": "Những quốc gia nào được phép sử dụng IBAN?",
  "biz_q_b2_opt_de_only": "Chỉ dành cho phiên bản Đức",
  "biz_q_b2_opt_eu": "Bất kỳ quốc gia nào thuộc EU",
  "biz_q_b3_help": "Khi câu trả lời là có, mã xác thực BR-50 / BR-51 và mã BIC sẽ được chuyển thành lỗi.",
  "biz_q_b3_label": "Mã BIC có bắt buộc không?",
  "biz_q_b3_opt_no": "Không — BIC là tùy chọn.",
  "biz_q_b3_opt_yes": "Có — Yêu cầu mã BIC",
  "biz_q_c1_help": "Không → Các quy tắc BR-AE-* trở thành lỗi và hóa đơn thu phí ngược bị từ chối trước khi nhập vào hệ thống kế toán phải trả.",
  "biz_q_c1_label": "Chấp nhận hóa đơn thu phí ngược (§13b UStG)?",
  "biz_q_c1_opt_no": "Không — từ chối thanh toán ngược",
  "biz_q_c1_opt_yes": "Đúng",
  "biz_q_c2_help": "Không → Các quy tắc BR-IC-* trở thành lỗi. Có là câu trả lời đúng cho hầu hết các thiết lập AP thực tế.",
  "biz_q_c2_label": "Chấp nhận hóa đơn nội khối EU?",
  "biz_q_c2_opt_no": "Không — bác bỏ nội bộ cộng đồng",
  "biz_q_c2_opt_yes": "Đúng",
  "biz_q_c3_help": "0 € loại bỏ hoàn toàn mọi sai lệch. 0,01 € khớp với giá trị mặc định của KoSIT và hấp thụ sai số làm tròn tự nhiên. 0,05 € là một thiết lập cho phép đối với các nhà cung cấp cũ.",
  "biz_q_c3_label": "Sai số làm tròn cho số tiền thuế (EUR)",
  "biz_q_c3_opt_0": "0 € (nghiêm ngặt)",
  "biz_q_c3_opt_0.01": "0,01 € (mặc định)",
  "biz_q_c3_opt_0.05": "0,05 € (khoan dung)",
  "biz_q_d1_help": "Các nhà cung cấp B2G luôn phải cung cấp mã Leitweg-ID. Chọn \"B2G-required\" nếu bạn nhận được nhiều loại nhà cung cấp khác nhau, hoặc \"Always required\" để bắt buộc sử dụng mã này cho tất cả các nhà cung cấp.",
  "biz_q_d1_label": "Có cần cung cấp thông tin người mua (mã số Leitweg) không?",
  "biz_q_d1_opt_always_required": "Luôn luôn cần thiết",
  "biz_q_d1_opt_b2g_required": "Các nhà cung cấp B2G phải báo giá",
  "biz_q_d1_opt_optional": "Không bắt buộc",
  "biz_q_d2_help": "VIES là thư mục mã số thuế GTGT của EU. Tra cứu trực tiếp giúp phát hiện các mã số thuế GTGT nước ngoài không hợp lệ trong quá trình nhập dữ liệu, nhưng sẽ thêm một cuộc gọi mạng cho mỗi hóa đơn — nên bỏ qua bước này đối với các thiết lập nội địa có khối lượng giao dịch lớn.",
  "biz_q_d2_label": "Tra cứu mã số thuế GTGT trực tuyến qua VIES?",
  "biz_q_d2_opt_no": "Không — bỏ qua bước tra cứu",
  "biz_q_d2_opt_yes": "Có — xác minh trực tuyến",
  "biz_q_e1_help": "Từ chối = hóa đơn chuyển sang trạng thái LỖI; nhóm Kế toán phải can thiệp. Chấp nhận kèm cảnh báo = hóa đơn tiếp tục được xử lý với một thông báo nhắc nhở. Chỉ ghi nhật ký = mọi lỗi đều được hạ cấp xuống mức cảnh báo (chế độ thử nghiệm).",
  "biz_q_e1_label": "Điều gì xảy ra khi quá trình xác thực thất bại?",
  "biz_q_e1_opt_accept_with_warning": "Chấp nhận kèm theo cảnh báo",
  "biz_q_e1_opt_log_only": "Chỉ ghi nhật ký (chế độ kiểm thử)",
  "biz_q_e1_opt_reject": "Từ chối hóa đơn",
  "biz_q_e2_help": "Nếu câu trả lời là có, khi bị từ chối, một email sẽ được gửi đến nhà cung cấp liệt kê các phát hiện xác nhận để họ có thể đưa ra biện pháp khắc phục.",
