  "biz_q_a1_opt_3": {
    "0": "3.0"
  },
  "biz_q_a2_help": "Các cấu hình không có trong danh sách này sẽ bị từ chối với thông báo VAL-PROFILE-NOT-ALLOWED. Các cấu hình MINIMUM và BASIC WL không tuân thủ tiêu chuẩn EN 16931 — chỉ kích hoạt chúng nếu bạn thực sự cần.",
  "biz_q_a2_label": "Bạn chấp nhận những loại hồ sơ ZUGFeRD / Factur-X nào?",
  "biz_q_a2_opt_basic": "NỀN TẢNG",
  "biz_q_a2_opt_basic_wl": "WL cơ bản",
