  "biz_preset_strict": "Strict",
  "biz_profile_b2b_domestic_desc": "KoSIT defaults across the board. Common payment via IBAN. Safe baseline for most German B2B traffic.",
  "biz_profile_b2b_domestic_label": "B2B Domestic — Standard German B2B",
  "biz_profile_b2b_eu_desc": "Intra-community supplies. Reverse charge enabled. Non-DE IBANs accepted. VAT-ID live-lookup via VIES is on by default.",
  "biz_profile_b2b_eu_label": "B2B EU Cross-border",
  "biz_profile_b2g_desc": "Receive XRechnung from German public-sector senders. EN 16931 + DE CIUS strict; Leitweg-ID required. Invalid invoices are rejected and suppliers are notified.",
  "biz_profile_b2g_label": "B2G — Public sector receiver",
  "biz_profile_custom_desc": "Walk through detail questions to build a policy tailored to your specific scenarios. Use this when none of the quick profiles fit.",
  "biz_profile_custom_label": "Custom — answer detail questions",
  "biz_profile_migration_desc": "Log-only mode for new e-invoice rollouts. Every violation is degraded to warning so suppliers can adjust without their invoices being blocked.",
  "biz_profile_migration_label": "Migration / Testing",
  "biz_q_a1_help": "Versions not on this list are rejected with VAL-VERSION-NOT-ALLOWED before any other check runs. Empty list = accept everything.",
  "biz_q_a1_label": "Which XRechnung versions do you accept?",
  "biz_q_a1_opt_1": {
    "2": "1.2"
  },
  "biz_q_a1_opt_2": {
    "0": "2.0",
    "1": "2.1",
    "2": "2.2",
    "3": "2.3"
  },
  "biz_q_a1_opt_3": {
    "0": "3.0"
  },
  "biz_q_a2_help": "Profiles not on this list are rejected with VAL-PROFILE-NOT-ALLOWED. MINIMUM and BASIC WL are not EN 16931 conformant — only enable them if you specifically need them.",
  "biz_q_a2_label": "Which ZUGFeRD / Factur-X profiles do you accept?",
  "biz_q_a2_opt_basic": "BASIC",
  "biz_q_a2_opt_basic_wl": "BASIC WL",
  "biz_q_a2_opt_en16931": "EN 16931",
  "biz_q_a2_opt_extended": "EXTENDED",
  "biz_q_a2_opt_minimum": "MINIMUM",
  "biz_q_a2_opt_xrechnung": "XRECHNUNG",
  "biz_q_a3_help": "Hybrid e-invoices technically require PDF/A-3. Allowing A-1 / A-2 demotes the PDFA-NOT-A3 finding from fatal to warning.",
  "biz_q_a3_label": "Allow PDF/A-1 or PDF/A-2 instead of PDF/A-3?",
  "biz_q_a3_opt_no": "No — PDF/A-3 only",
  "biz_q_a3_opt_yes": "Yes — also allow A-1 / A-2",
  "biz_q_b1_help": "If yes, all IBAN-related checks (BR-DE-19/20, VAL-IBAN-*) are demoted to warning.",
  "biz_q_b1_label": "Accept invoices without IBAN at all?",
  "biz_q_b1_opt_no": "No — IBAN required",
  "biz_q_b1_opt_yes": "Yes — IBAN optional",
  "biz_q_b2_help": "DE-only is for purely domestic German suppliers. EU allows any ISO 3166 country (recommended for cross-border AP).",
  "biz_q_b2_label": "Which IBAN countries should be allowed?",
  "biz_q_b2_opt_de_only": "DE-only",
  "biz_q_b2_opt_eu": "Any EU country",
  "biz_q_b3_help": "When yes, BR-50 / BR-51 and the BIC validation codes are promoted to error.",
  "biz_q_b3_label": "Is BIC mandatory?",
  "biz_q_b3_opt_no": "No — BIC optional",
  "biz_q_b3_opt_yes": "Yes — BIC required",
  "biz_q_c1_help": "No → BR-AE-* rules become errors and reverse-charge invoices are rejected before they enter AP.",
  "biz_q_c1_label": "Accept reverse-charge invoices (§13b UStG)?",
  "biz_q_c1_opt_no": "No — reject reverse-charge",
  "biz_q_c1_opt_yes": "Yes",
  "biz_q_c2_help": "No → BR-IC-* rules become errors. Yes is the right answer for almost all real-world AP setups.",
  "biz_q_c2_label": "Accept EU intra-community invoices?",
  "biz_q_c2_opt_no": "No — reject intra-community",
  "biz_q_c2_opt_yes": "Yes",
  "biz_q_c3_help": "0 € rejects every cent of drift. 0,01 € matches the KoSIT default and absorbs natural rounding. 0,05 € is a permissive setting for legacy suppliers.",
  "biz_q_c3_label": "Rounding tolerance for tax amounts (EUR)",
  "biz_q_c3_opt_0": "0 € (strict)",
  "biz_q_c3_opt_0.01": "0,01 € (default)",
  "biz_q_c3_opt_0.05": "0,05 € (lenient)",
  "biz_q_d1_help": "B2G suppliers must always quote a Leitweg-ID. Choose \"B2G-required\" if you receive a mix, or \"Always required\" to enforce it across the board.",
  "biz_q_d1_label": "Is a buyer reference (Leitweg-ID) required?",
  "biz_q_d1_opt_always_required": "Always required",
  "biz_q_d1_opt_b2g_required": "B2G suppliers must quote it",
  "biz_q_d1_opt_optional": "Optional",
  "biz_q_d2_help": "VIES is the EU's VAT-ID directory. Live-lookup catches invalid foreign VAT-IDs at ingest but adds a network call per invoice — leave off for high-volume domestic setups.",
  "biz_q_d2_label": "Live VAT-ID lookup via VIES?",
  "biz_q_d2_opt_no": "No — skip lookup",
  "biz_q_d2_opt_yes": "Yes — verify online",
  "biz_q_e1_help": "Reject = invoice goes to ERROR status; AP team must intervene. Accept-with-warning = invoice continues with a banner. Log-only = every finding is downgraded to warning (testing mode).",
  "biz_q_e1_label": "What happens on validation failure?",
  "biz_q_e1_opt_accept_with_warning": "Accept with warning",
  "biz_q_e1_opt_log_only": "Log only (testing mode)",
  "biz_q_e1_opt_reject": "Reject invoice",
  "biz_q_e2_help": "If yes, on rejection an email goes to the supplier listing the validation findings, so they can issue a correction.",
  "biz_q_e2_label": "Notify the supplier on rejection?",
  "biz_q_e2_opt_no": "No — silent rejection",
  "biz_q_e2_opt_yes": "Yes — email supplier",
